# Copy to .env.local and fill in. Never commit .env.local.
# Mixpanel service account (Organization/Project settings > Service Accounts)
MIXPANEL_SERVICE_ACCOUNT_USER=
MIXPANEL_SERVICE_ACCOUNT_SECRET=
MIXPANEL_PROJECT_ID=
# Alternative (legacy): project API Secret from Project Settings > Access Keys.
# Used only when no service account is set above.
MIXPANEL_API_SECRET=
# us | eu | in
MIXPANEL_REGION=eu
# Optional: read events from a local JSON/JSONL file instead of calling Mixpanel
# (comma-separated for several files, e.g. a.json,b.json). Takes precedence over the credentials above.
MIXPANEL_EVENTS_FILE=
